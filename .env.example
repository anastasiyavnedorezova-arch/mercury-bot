# Telegram Bot
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=

# OpenAI
OPENAI_API_KEY=

# Голос: по умолчанию openai. yandex = SpeechKit API v3 напрямую, без скрытого fallback.
AI_VOICE_PROVIDER=
# Необязательный отдельный ключ SpeechKit; иначе используется YANDEX_API_KEY.
# Нужен доступ к распознаванию речи, а не только к языковым моделям.
YANDEX_SPEECHKIT_API_KEY=

# JWT (подпись входа в кабинет; длинная случайная строка)
JWT_SECRET=

# Публичный адрес сайта — для ссылок в письмах (смена пароля). Пусто = https://finnikbot.ru
APP_BASE_URL=

# RuSender (email-рассылки)
# Токен API — берётся из личного кабинета RuSender
RUSENDER_API_TOKEN=
# Числовой ID «ключа отправки» в RuSender
RUSENDER_KEY_ID=
# Адрес отправителя
MAIL_FROM_EMAIL=
# Имя отправителя (например: Финник)
MAIL_FROM_NAME=
# Куда слать уведомления об обращениях (по умолчанию MAIL_FROM_EMAIL)
ADMIN_NOTIFY_EMAIL=
# Только внутренние аварийные письма: список через запятую, каждый получает отдельное письмо.
# Если пусто, используется ADMIN_NOTIFY_EMAIL / MAIL_FROM_EMAIL. Поддержку/письма пользователям не меняет.
HEALTH_ALERT_EMAILS=
# Независимый маршрут Telegram-оповещений и запасной, например quicksrv, затем Hostkey.
ALERT_TELEGRAM_API_BASE_URL=
ALERT_TELEGRAM_FALLBACK_API_BASE_URL=
# Отдельная регулярная проверка резерва: корень https://relay-backup.finnikbot.ru
BACKUP_RELAY_BASE_URL=
# Установить в 'false' чтобы отключить приветственное письмо после регистрации
WELCOME_EMAIL_ENABLED=

# Адреса для работы через ретранслятор (если бот работает без ретранслятора, оставить пустыми)
# Telegram Bot API, например: https://relay.finnikbot.ru/telegram
TELEGRAM_API_BASE_URL=
# OpenAI, например: https://relay.finnikbot.ru/openai/v1
OPENAI_BASE_URL=

# База данных — собственный PostgreSQL (обязательно).
# Пример: postgresql://finnik:ПАРОЛЬ@127.0.0.1:5432/finnik
DATABASE_URL=
# Только для тестов (база должна называться *_test, её содержимое при тестах стирается!)
TEST_DATABASE_URL=

# Optional onboarding communication prompts; enable on stage after migration 014.
COMMUNICATION_ONBOARDING_ENABLED=false
# Telegram channel URL, including private invite links (keep actual invite in protected env).
NEWS_CHANNEL_URL=
