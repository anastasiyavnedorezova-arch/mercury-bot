# Telegram Bot
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=

# OpenAI
OPENAI_API_KEY=

# JWT (подпись входа в кабинет; длинная случайная строка)
JWT_SECRET=

# Публичный адрес сайта — для ссылок в письмах (смена пароля). Пусто = https://finnikbot.ru
APP_BASE_URL=

# RuSender (email-рассылки)
# Токен API — берётся из личного кабинета RuSender
RUSENDER_API_TOKEN=
# Числовой ID «ключа отправки» в RuSender
RUSENDER_KEY_ID=
# Адрес отправителя
MAIL_FROM_EMAIL=
# Имя отправителя (например: Финник)
MAIL_FROM_NAME=
# Куда слать уведомления об обращениях (по умолчанию MAIL_FROM_EMAIL)
ADMIN_NOTIFY_EMAIL=
# Установить в 'false' чтобы отключить приветственное письмо после регистрации
WELCOME_EMAIL_ENABLED=

# Адреса для работы через ретранслятор (если бот работает без ретранслятора, оставить пустыми)
# Telegram Bot API, например: https://relay.finnikbot.ru/telegram
TELEGRAM_API_BASE_URL=
# OpenAI, например: https://relay.finnikbot.ru/openai/v1
OPENAI_BASE_URL=

# База данных — собственный PostgreSQL (обязательно).
# Пример: postgresql://finnik:ПАРОЛЬ@127.0.0.1:5432/finnik
DATABASE_URL=
# Только для тестов (база должна называться *_test, её содержимое при тестах стирается!)
TEST_DATABASE_URL=
